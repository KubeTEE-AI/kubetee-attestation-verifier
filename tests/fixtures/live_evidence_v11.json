cessRequest := true\ndefault WriteStreamRequest := false\n\n# Allow only allowlisted containers. The pause container (container-type\n# \"sandbox\", no image-name annotation) and workload containers (image-name\n# annotation) are checked against policy_data.containers below.\nCreateContainerRequest if {\n\ti_oci := input.OCI\n\n\t# sandbox/pause container\n\ti_oci.Annotations[\"io.kubernetes.cri.container-type\"] == \"sandbox\"\n\tsome p in policy_data.containers\n\tp.OCI.Annotations[\"io.kubernetes.cri.container-type\"] == \"sandbox\"\n}\n\nCreateContainerRequest if {\n\ti_oci := input.OCI\n\ti_uid := i_oci.Process.User.UID\n\ti_gid := i_oci.Process.User.GID\n\n\ti_image := i_oci.Annotations[\"io.kubernetes.cri.image-name\"]\n\n\tsome p in policy_data.containers\n\tp.OCI.Annotations[\"io.kubernetes.cri.image-name\"] == i_image\n\n\tp_oci := p.OCI\n\tp_oci.Process.User.UID == i_uid\n\tp_oci.Process.User.GID == i_gid\n\n\t# pidns consistency: workload containers share the sandbox pid ns\n\tinput.sandbox_pidns == p.sandbox_pidns\n}\n\n# Measured container allowlist — image names + UIDs (+ the pause container by\n# container-type). Shape matches the AS extraction (agent_policy_claims):\n#   containers[].OCI.Annotations.\"io.kubernetes.cri.image-name\"\n#   containers[].OCI.Process.User.UID\n# UIDs (verified live via crictl on am-h200-28 2026-09-18): litellm-database\n# runs as root (UID 0, image Dockerfile USER root); the pause container runs\n# as 65535 (RKE2 mirrored-pause, \"nobody\"). sandbox_pidns is FALSE for every\n# container here — runtime-rs is_pid_namespace_enabled() returns true only\n# when the PID namespace entry has a path set, and these pods share no PID ns\n# (verified live: pid ns path=None on pause + both workloads). Image references\n# must match OCI exactly: tag@digest is preserved by this runtime + containerd\n# path in io.kubernetes.cri.image-name (verified in host kata journal 2026-11-10).\n# Only the CURRENT image is listed (stale tags pruned 2